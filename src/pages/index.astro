---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getEntry, render } from 'astro:content';

const home = await getEntry('pages', 'home');
const { Content } = home ? await render(home) : { Content: null };
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="fade-up" style="padding-top: 0; padding-bottom: 0;">

      <!-- Row: Full Width Banner -->
      <div style="height: 7em; overflow: hidden; width: 100vw; margin-left: calc(-50vw + 50%);">
        <img
          src="/images/20260608 tease blog banners tea kettle pouring.png"
          alt=""
          class="img-tilt-right"
          style="width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 0;"
        />
      </div>

      <!-- Row: Text -->
      <div class="px-6 py-16 text-center" style="background: var(--accent-crimson); color: var(--color-parchment); width: 100vw; margin-left: calc(-50vw + 50%); margin-top: -3em;">
        <h1 style="color: var(--color-raw-gold);">Our Promise:</h1>
        <p style="color: var(--color-parchment); max-width: 720px; margin: 0 auto;">
          Every tea in our collection made us stop mid-sip and take notes. If it doesn't make us obsessed, it doesn't go to your table.
          We cultivate relationships with generational growers who obsess over their craft the way we obsess over ours, and bring back only what genuinely moved us.
          If it didn't seduce us first, it won't reach your door.
        </p>
      </div>

      {Content && <Content />}

    </main>
    <Footer />
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", user => {
          if (!user) {
            window.netlifyIdentity.on("login", () => {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
  </body>
</html>