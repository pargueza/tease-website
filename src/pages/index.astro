---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getEntry, render } from 'astro:content';

const home = await getEntry('pages', 'home');
const { Content } = home ? await render(home) : { Content: null };
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="fade-up" style="padding-top: 0; padding-bottom: 0;">

      <!-- Row: Full Width Banner -->
      <div style="height: 7em; overflow: hidden; width: 100vw; margin-left: calc(-50vw + 50%);">
        <img
          src="/images/20260608-tease-blog-banners-tea-kettle-pouring.png"
          alt=""
          class="img-tilt-right"
          style="width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 0;"
        />
      </div>

      <!-- Wrapper: Red section + leaf overlay -->
      <div style="position: relative; width: 100vw; margin-left: calc(-50vw + 50%);">

        <!-- Row: Text -->
        <div class="px-6 py-16 text-center" style="background: var(--accent-crimson); color: var(--color-parchment); position: relative; z-index: 0; margin-top: -3em;">

          <!-- Logo -->
          <div style="text-align: center;">
            <a href="/">
              <img src="/images/negative-logo-transparent-background.png" alt="Tease Logo" style="height: 15em; width: auto; display: inline-block;" />
            </a>
          </div>

          <h1 style="color: var(--color-raw-gold);">Welcome, Tea Lovers</h1>
          <h3 style="color: var(--color-parchment);">Luxe teas for sophisticated palates.</h3>
          <p style="color: var(--color-parchment); max-width: 720px; margin: 0 auto;">
            <strong>Our mission is simple:</strong> connecting 100 tea lovers with exclusive opportunities to sip and savor premium flavors in an intimate setting.
          </p>
          <p style="color: var(--color-parchment); max-width: 720px; margin: 1em auto;">
            <strong>Our seasonal selections will scintillate your senses.</strong> Tease your tongue and expand your horizons, from high mountain oolong and oceanic gyokuro to earthy pu'er.
          </p>
          <p style="color: var(--color-parchment); max-width: 720px; margin: 1em auto;">
            <strong>100% quality guaranteed. If it didn't move us, it won't make it to your cup.</strong>
          </p>
          <p style="color: var(--color-parchment); max-width: 720px; margin: 1em auto;">
            - James and Nadine
          </p>
        </div>

        <!-- Row: Image overlapping previous div -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0.15; z-index: 1; pointer-events: none;">
          <img src="/images/20260609-tease-blog-banners-white-tea-leaves-right.png" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
        </div>

      </div>

    </main>
    <Footer />
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", user => {
          if (!user) {
            window.netlifyIdentity.on("login", () => {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
  </body>
</html>