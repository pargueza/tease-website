---
import { getEntry, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const about = await getEntry('pages', 'about');
const { Content } = about ? await render(about) : { Content: null };
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Contact" description="Contact Tease" />

    <style>
      /* IMPORTANT: removes default browser offset */
      body {
        margin: 0;
        overflow-x: hidden;
      }

      main {
        margin: 0;
        padding: 0;
      }

      /* Your original parallax behavior (unchanged logic) */
      .parallax-banner {
        min-height: 120vh;
        background-image: url('/images/20260608-tease-blog-banners-white-tea.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
      }

      @media (max-width: 768px) {
        .parallax-banner {
          background-attachment: scroll;
        }
      }

      /* Fix iframe layout so it doesn't distort page width */
      .embed-wrapper {
        display: flex;
        justify-content: center;
        width: 100%;
        padding: 2rem 0;
      }

      .embed-wrapper iframe {
        width: min(700px, 92vw);
        height: 70vh;
        border: 0;
        display: block;
        background: white;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
      }
    </style>
  </head>

  <body>
    <Header />

    <main class="fade-up">

      <!-- CONTACT EMBED (centered, no layout breaking) -->
      <div class="embed-wrapper">
        <script src="https://anvil.works/embed.js" async></script>
        <iframe
          data-anvil-embed
          src="https://luminous-trim-sweet.anvil.app"
        ></iframe>
      </div>

      <!-- PARALLAX BANNER (flush, no width hacks needed) -->
      <section class="parallax-banner"></section>

    </main>

    <Footer />
  </body>
</html>