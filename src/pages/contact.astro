---
import { getEntry, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';

const about = await getEntry('pages', 'about');
const { Content } = about ? await render(about) : { Content: null };
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Contact" description="Contact Tease" />
  </head>
  <body>
    <Header />
    <main class="fade-up" style="padding-top: 0; padding-bottom: 0;">

      <!-- Row: Full Width Banner -->
      <div 
        class="img-tilt-left parallax-banner"
        style="height: 7em; width: 100vw; margin-left: calc(-50vw + 50%); background-image: url('/images/20260608-tease-blog-banners-teacups.png');"
      >
      </div>

      {Content && <Content />}

      <script src="https://anvil.works/embed.js" async></script>
      <iframe style="width:100%;" data-anvil-embed src="https://luminous-trim-sweet.anvil.app"></iframe>

      <!-- Row: Full Width Banner -->
      <div 
        class="parallax-banner"
        style="height: 7em; width: 100vw; margin-left: calc(-50vw + 50%); background-image: url('/images/20260608-tease-blog-banners-white-tea.png');"
      >
      </div>

    </main>
    <Footer />
  </body>
</html>