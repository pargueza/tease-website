---
import { getEntry, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const about = await getEntry('pages', 'about');
const { Content } = about ? await render(about) : { Content: null };
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Contact" description="Contact Tease" />
  </head>

  <body>
    <Header />

    <main class="fade-up">
      <div
        style="
          width: 100vw;
          margin-left: calc(-50vw + 50%);
          min-height: 25em;
          background-image: url('/images/20260608-tease-blog-banners-white-tea.png');
          background-repeat: no-repeat;
          background-size: cover;
          background-position: center;
        "
        class="px-6 py-12, parallax-image"
      >
        <!-- Embedded Contact Form -->
        <script src="https://anvil.works/embed.js" async></script>
        <iframe data-anvil-embed src="https://luminous-trim-sweet.anvil.app"></iframe>
      </div>
      
    </main>

    <Footer />
  </body>
</html>