---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Join" description="Join Tease" />
  </head>
  <body>
    <Header />
    <main class="fade-up" style="padding-top: 0; padding-bottom: 0;">

      <!-- Row: Full Width Banner -->
      <div style="height: 7em; overflow: hidden; width: 100vw; margin-left: calc(-50vw + 50%);">
        <img
          src="/images/20260608-tease-blog-banners-tea-kettle-pour.png"
          alt=""
          class="img-tilt-left parallax-banner"
          style="width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 0;"
        />
      </div>

      <!-- Row: Text -->
      <div class="px-6 py-16 text-center" style="background: var(--accent-dark); color: var(--color-parchment); width: 100vw; margin-left: calc(-50vw + 50%); margin-top: -3em;">
        <h1 style="color: var(--color-raw-gold);">Join Tease Society</h1>
        <h3 style="color: var(--color-parchment);">Membership is earned. Pleasure is guaranteed.</h3>
        <p style="color: var(--color-parchment); max-width: 720px; margin: 0 auto;">
          Four times a year, extraordinary teas are delivered in plus packaging to your door. Each one is chosen to stimulate your senses and promote deep connections when shared.
        </p>

        <!-- Logo -->
        <div style="text-align: center; margin-top: 2em;">
          <a href="/">
            <img src="/images/negative-logo-transparent-background.png" alt="Tease Logo" style="height: 7em; width: auto; display: inline-block;" />
          </a>
        </div>
      </div>

      <!-- Row: Form -->
      <div class="text-center py-12 px-6">
        <h2>Fill out the form to join the club.</h2>
        <script src="https://anvil.works/embed.js" async></script>
        <iframe style="width:100%;" data-anvil-embed src="https://luminous-trim-sweet.anvil.app"></iframe>
      </div>

    </main>
    <Footer />
  </body>
</html>